-- Teste 3: ST seguido de LD, base em registrador e offset negativo
-- (LD R7 le a propria instrucao do endereco 0: memoria unificada).

DEPTH = 256;
WIDTH = 16;
ADDRESS_RADIX = DEC;
DATA_RADIX = BIN;

CONTENT BEGIN
    0 : 0101001000011001; -- ADDI R1, R0, 25    | 0101 001 000 011001
    1 : 0101010000111001; -- ADDI R2, R0, -7    | 0101 010 000 111001
    2 : 0111001000011110; -- ST R1, R0, 30      | 0111 001 000 011110
    3 : 0111010000011111; -- ST R2, R0, 31      | 0111 010 000 011111
    4 : 0110011000011110; -- LD R3, R0, 30      | 0110 011 000 011110
    5 : 0110100000011111; -- LD R4, R0, 31      | 0110 100 000 011111
    6 : 0101101000001010; -- ADDI R5, R0, 10    | 0101 101 000 001010
    7 : 0111010101010010; -- ST R2, R5, 18      | 0111 010 101 010010
    8 : 0110110101010010; -- LD R6, R5, 18      | 0110 110 101 010010
    9 : 0110111101110110; -- LD R7, R5, -10     | 0110 111 101 110110
    10 : 1010000000001010; -- JMP 10             | 1010 000000001010
    [11..255] : 0000000000000000;
END;
