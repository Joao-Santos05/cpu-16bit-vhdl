-- Teste 5: JMP para frente e para tras. R2 deve ficar em 0.

DEPTH = 256;
WIDTH = 16;
ADDRESS_RADIX = DEC;
DATA_RADIX = BIN;

CONTENT BEGIN
    0 : 0101001000000001; -- ADDI R1, R0, 1     | 0101 001 000 000001
    1 : 1010000000000100; -- JMP 4              | 1010 000000000100
    2 : 0101010000000010; -- ADDI R2, R0, 2     | 0101 010 000 000010
    3 : 1010000000000110; -- JMP 6              | 1010 000000000110
    4 : 0101011000000011; -- ADDI R3, R0, 3     | 0101 011 000 000011
    5 : 1010000000000011; -- JMP 3              | 1010 000000000011
    6 : 0101100000000100; -- ADDI R4, R0, 4     | 0101 100 000 000100
    7 : 1010000000000111; -- JMP 7              | 1010 000000000111
    [8..255] : 0000000000000000;
END;
