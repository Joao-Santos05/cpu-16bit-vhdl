-- Teste 1: ADDI/ADD/SUB, imediatos extremos (-32, 31), negativos e escrita em R0.

DEPTH = 256;
WIDTH = 16;
ADDRESS_RADIX = DEC;
DATA_RADIX = BIN;

CONTENT BEGIN
    0 : 0101001000001010; -- ADDI R1, R0, 10    | 0101 001 000 001010
    1 : 0101010000111101; -- ADDI R2, R0, -3    | 0101 010 000 111101
    2 : 0000011001010000; -- ADD R3, R1, R2     | 0000 011 001 010 000
    3 : 0001100010001000; -- SUB R4, R2, R1     | 0001 100 010 001 000
    4 : 0101101001011111; -- ADDI R5, R1, 31    | 0101 101 001 011111
    5 : 0101110000100000; -- ADDI R6, R0, -32   | 0101 110 000 100000
    6 : 0001111001001000; -- SUB R7, R1, R1     | 0001 111 001 001 000
    7 : 0101000001000101; -- ADDI R0, R1, 5     | 0101 000 001 000101
    8 : 0000111111000000; -- ADD R7, R7, R0     | 0000 111 111 000 000
    9 : 1010000000001001; -- JMP 9              | 1010 000000001001
    [10..255] : 0000000000000000;
END;
