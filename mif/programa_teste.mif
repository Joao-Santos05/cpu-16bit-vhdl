-- Programa de teste do plano: ADDI, ADD, SUB, ST, LD, JMP.

DEPTH = 256;
WIDTH = 16;
ADDRESS_RADIX = DEC;
DATA_RADIX = BIN;

CONTENT BEGIN
    0 : 0101001000000101; -- ADDI R1, R0, 5     | 0101 001 000 000101
    1 : 0101010000000011; -- ADDI R2, R0, 3     | 0101 010 000 000011
    2 : 0000011001010000; -- ADD R3, R1, R2     | 0000 011 001 010 000
    3 : 0001100011010000; -- SUB R4, R3, R2     | 0001 100 011 010 000
    4 : 0111011000010100; -- ST R3, R0, 20      | 0111 011 000 010100
    5 : 0110101000010100; -- LD R5, R0, 20      | 0110 101 000 010100
    6 : 1010000000000110; -- JMP 6              | 1010 000000000110
    [7..255] : 0000000000000000;
END;
