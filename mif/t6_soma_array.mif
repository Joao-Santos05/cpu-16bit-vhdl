-- Teste 6: soma de Mem[20..24] (laco com LD, ADD, ADDI, BNE), resultado em Mem[25].
-- Branch: alvo = endereco do branch + 1 + imm.

DEPTH = 256;
WIDTH = 16;
ADDRESS_RADIX = DEC;
DATA_RADIX = BIN;

CONTENT BEGIN
    0 : 0101001000010100; -- ADDI R1, R0, 20    | 0101 001 000 010100
    1 : 0101010000011001; -- ADDI R2, R0, 25    | 0101 010 000 011001
    2 : 0101011000000000; -- ADDI R3, R0, 0     | 0101 011 000 000000
    3 : 0110100001000000; -- LD R4, R1, 0       | 0110 100 001 000000
    4 : 0000011011100000; -- ADD R3, R3, R4     | 0000 011 011 100 000
    5 : 0101001001000001; -- ADDI R1, R1, 1     | 0101 001 001 000001
    6 : 1001001010111100; -- BNE R1, R2, -4     | 1001 001 010 111100
    7 : 0111011000011001; -- ST R3, R0, 25      | 0111 011 000 011001
    8 : 0110101000011001; -- LD R5, R0, 25      | 0110 101 000 011001
    9 : 1010000000001001; -- JMP 9              | 1010 000000001001
    [10..19] : 0000000000000000;
    20 : 0000000000000011; -- dado = 3
    21 : 0000000000000101; -- dado = 5
    22 : 0000000000000111; -- dado = 7
    23 : 0000000000001011; -- dado = 11
    24 : 0000000000001101; -- dado = 13
    [25..255] : 0000000000000000;
END;
