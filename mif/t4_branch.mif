-- Teste 4: BEQ/BNE tomados e nao tomados.
-- Branch: alvo = endereco do branch + 1 + imm.
-- R4 e R6 devem ficar em 0 (instrucoes puladas).

DEPTH = 256;
WIDTH = 16;
ADDRESS_RADIX = DEC;
DATA_RADIX = BIN;

CONTENT BEGIN
    0 : 0101001000000101; -- ADDI R1, R0, 5     | 0101 001 000 000101
    1 : 0101010000000101; -- ADDI R2, R0, 5     | 0101 010 000 000101
    2 : 0101011000000111; -- ADDI R3, R0, 7     | 0101 011 000 000111
    3 : 1000001010000001; -- BEQ R1, R2, 1      | 1000 001 010 000001
    4 : 0101100000000001; -- ADDI R4, R0, 1     | 0101 100 000 000001
    5 : 1000001011000001; -- BEQ R1, R3, 1      | 1000 001 011 000001
    6 : 0101101000000010; -- ADDI R5, R0, 2     | 0101 101 000 000010
    7 : 1001001011000001; -- BNE R1, R3, 1      | 1001 001 011 000001
    8 : 0101110000000011; -- ADDI R6, R0, 3     | 0101 110 000 000011
    9 : 1001001010000001; -- BNE R1, R2, 1      | 1001 001 010 000001
    10 : 0101111000000100; -- ADDI R7, R0, 4     | 0101 111 000 000100
    11 : 1010000000001011; -- JMP 11             | 1010 000000001011
    [12..255] : 0000000000000000;
END;
