-- Teste 2: AND, OR, SLT (inclusive comparacao com sinal).

DEPTH = 256;
WIDTH = 16;
ADDRESS_RADIX = DEC;
DATA_RADIX = BIN;

CONTENT BEGIN
    0 : 0101001000001100; -- ADDI R1, R0, 12    | 0101 001 000 001100
    1 : 0101010000001010; -- ADDI R2, R0, 10    | 0101 010 000 001010
    2 : 0010011001010000; -- AND R3, R1, R2     | 0010 011 001 010 000
    3 : 0011100001010000; -- OR R4, R1, R2      | 0011 100 001 010 000
    4 : 0100101010001000; -- SLT R5, R2, R1     | 0100 101 010 001 000
    5 : 0100110001010000; -- SLT R6, R1, R2     | 0100 110 001 010 000
    6 : 0101111000111111; -- ADDI R7, R0, -1    | 0101 111 000 111111
    7 : 0100111111001000; -- SLT R7, R7, R1     | 0100 111 111 001 000
    8 : 1010000000001000; -- JMP 8              | 1010 000000001000
    [9..255] : 0000000000000000;
END;
